{
  "name": "egirls-crypto-banhammer-telegram-bot",
  "version": "1.4.82",
  "description": "Bot made for chat moderation of comments chat in Telegram messenger",
  "author": "tsehla42",
  "license": "GPL-3.0",
  "main": "dist/bot.js",
  "scripts": {
    "compile": "npx tsc",
    "watch-compile": "tsc --watch",
    "bot": "nodemon -w dist -x node dist/bot.js",
    "dev": "concurrently npm:watch-compile npm:bot",
    "compose": "compose.sh",
    "clean-messages": "npx ts-node references/clean-messages.ts",
    "list-groups": "npx ts-node scripts/list-bot-groups.ts",
    "unban-test-user": "npx ts-node scripts/unban-test-user.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "concurrently": "10.0.5",
    "nodemon": "3.1.14",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  },
  "dependencies": {
    "@grammyjs/auto-retry": "2.0.2",
    "dotenv": "17.4.2",
    "env-var": "7.5.0",
    "grammy": "1.46.0"
  }
}
